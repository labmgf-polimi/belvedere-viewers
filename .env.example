# Template for the belvedere-viewers environment.
# Copy to .env and fill in:  cp .env.example .env
#
# These three variables are the ONLY ones this service reads — app/config.php is
# the single place they are consumed, and it hands them to the browser as JS
# constants. The same three must be set in the Dokploy environment for the
# viewers service.

# Public URL of the backend API. Served to the browser, so it must be reachable
# from the client, not just from inside the container.
# No trailing slash: the viewers build paths as `${API_BASE}/surveys/...`.
API_BASE=https://api.example.com

# MapTiler key for the Cesium terrain under the point clouds. Without it the
# viewer falls back to the flat WGS84 ellipsoid and the OSM basemap renders far
# below the glacier. Free key at https://cloud.maptiler.com/
MAPTILER_KEY=your-maptiler-key

# Base URL for the Potree point clouds and background meshes. Public bucket —
# not a secret, no credentials involved. The layout below it is fixed:
#   <base>/pointclouds/<year>/metadata.json
#   <base>/meshes/<year>/model.glb
# so viewer.js derives both paths from this single value. No trailing slash.
# If unset, config.php falls back to the production bucket.
POTREE_ASSETS_BASE=https://your-bucket.example.com/potree